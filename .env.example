# === App ===
APP_NAME=pytbak
APP_VERSION=2.0.0
APP_ENV=development          # development | production | test
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# === Auth (basic auth for /debug endpoints) ===
DIAG_USERNAME=admin
DIAG_PASSWORD=password

# === Redis ===
# Development: redis://redis:6379/0  (docker-compose service)
# Production:  https://your-redis-endpoint.example.com  (HTTP/S endpoint)
# Omit to disable Redis (fallback to in-memory)
REDIS_URL=redis://redis:6379/0
# Legacy (used if REDIS_URL is not set):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# === PostgreSQL ===
# Development: postgresql+asyncpg://pytbak:pytbak@postgres:5432/pytbak  (docker-compose)
# Production:  postgresql+asyncpg://user:pass@your-pg.example.com:5432/db  (external)
# Omit to disable PostgreSQL (fallback to in-memory)
DATABASE_URL=postgresql+asyncpg://pytbak:pytbak@postgres:5432/pytbak

# === Cache ===
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# === Rate Limiting ===
RATE_LIMIT=100/minute

# === OpenTelemetry (traces) ===
# The app exports traces via OTLP. Point to your collector:
#   - Datadog Agent:  http://datadog-agent:4317  (Agent OTLP ingest)
#   - Generic:        http://otel-collector:4317
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pytbak

# === Prometheus (metrics) ===
# The app exposes /metrics (scrape-ready). Scrapers:
#   - Datadog Agent:  auto-discovers /metrics via annotations or openmetrics check
#   - Prometheus:     scrape http://pytbak:8000/metrics
PROMETHEUS_ENABLED=true

# === Webdis (legacy) ===
WEBDIS_URL=http://webdis-svc.webdis:7379
